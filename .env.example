# TaxMitra environment template
# Copy to .env and fill in. Every variable is optional — the app runs
# in "static mode" (offline-friendly calculators + seeded/static data)
# with zero env vars, and upgrades feature-by-feature as you add keys.

# ---- Database (Postgres) ---------------------------------------------------
# Without DATABASE_URL the site runs in static mode: calculators, static
# CA/loan data and PWA keep working; DB-backed features degrade gracefully.
DATABASE_URL=postgresql://user:pass@localhost:5432/taxmitra

# ---- Optional feature keys --------------------------------------------------
# LLM polish for the ITR chatbot (the rule engine works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Razorpay live payments (without keys /api/checkout returns demo orders)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp reminders for the GSTR cron (Gupshup / Interakt)
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
# Public business WhatsApp number for CTAs (91XXXXXXXXXX format, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Protects /api/cron/gst-reminders (sent as x-cron-secret header or ?secret=)
CRON_SECRET=

# Access key for /admin (URL ?key=ADMIN_KEY)
ADMIN_KEY=admin-local

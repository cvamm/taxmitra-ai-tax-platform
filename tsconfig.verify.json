{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"],
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "next.config.ts",
    "drizzle.config.json",
    "tsconfig.verify.json"
  ],
  "exclude": ["node_modules", ".next"]
}
